# Linear credentials
LINEAR_API_KEY=
# Optional: restrict sync to a specific Linear organization UUID
LINEAR_WORKSPACE_ID=

# BFF server
BFF_PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Plane mapping (set to match your Linear org / desired URL slug)
PLANE_WORKSPACE_SLUG=
PLANE_WORKSPACE_NAME=
MOCK_USER_EMAIL=dev@linear.local
MOCK_USER_NAME=Linear Viewer

# Cache
CACHE_POLL_INTERVAL_MS=3000
CACHE_INITIAL_FETCH=true
